{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4binance.local/schemas/github-radar-research-unit-v1.json",
  "title": "AI4BINANCE GitHub Radar Research Unit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_id", "capability_id", "source", "evidence", "risks",
    "scores", "recommendation", "blockers", "execution_allowed",
    "promotion_status", "live_eligibility_status"
  ],
  "properties": {
    "research_id": {"type": "string", "pattern": "^GR-[0-9a-f]{20}$"},
    "capability_id": {"type": "string", "pattern": "^R[0-3][0-9]-C[0-9]{2}$"},
    "source": {
      "type": "object",
      "required": ["repository", "url", "pinned_revision", "license_id"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "pinned_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license_id": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {"type": "array", "items": {"type": "object"}},
    "risks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scores": {"type": "object"},
    "recommendation": {"enum": ["REJECT", "WATCH", "RESEARCH", "POC", "ADOPT_IDEA"]},
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "execution_allowed": {"const": false},
    "promotion_status": {"const": "RESEARCH_ONLY"},
    "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}
  }
}
