AI4BINANCE_LLAMA_GPU_LAYERS=0
AI4BINANCE_LLAMA_PARALLEL=2
AI4BINANCE_LLAMA_THREADS=8
AI4BINANCE_ADVISORY_LLM_MODE=RESEARCH_ONLY
AI4BINANCE_PROMPTER_MODEL=qwen3:8b
AI4BINANCE_PROMPTER_TIMEOUT_SECONDS=120
