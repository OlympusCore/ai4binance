AI4BINANCE_REQUEST_TIMEOUT_SECONDS=10
AI4BINANCE_REQUEST_MAX_ATTEMPTS=3
AI4BINANCE_REQUEST_BACKOFF_SECONDS=0.25
AI4BINANCE_CANDLE_LIMIT=250
AI4BINANCE_MINIMUM_CLOSED_CANDLES=200
AI4BINANCE_MAX_DATA_WORKERS=4
AI4BINANCE_AUDIT_DIRECTORY=Logs
AI4BINANCE_DATASET_DIRECTORY=Data/market
AI4BINANCE_VALIDATION_ARTIFACT_DIRECTORY=Backtest/validation
AI4BINANCE_EVIDENCE_ARTIFACT_DIRECTORY=Artifacts
AI4BINANCE_RUNTIME_STATE_PATH=State/runtime.json
