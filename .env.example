OLLAMA_HOST=127.0.0.1:11434
# Binance API credentials are intentionally omitted from this example.
# Set them only in Secrets/bnc.env or in secure environment variables.
# ED25519 private-key paths/passphrases are also local-only.
# Social/publishing tokens and chat identifiers are intentionally omitted.
# Configure them only in local secure environment variables when needed.
