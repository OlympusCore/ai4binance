{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4binance:schema:technology:technology-finding:1.0.0",
  "title": "AI4Binance Technology Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "detected_at", "status", "evidence_refs", "execution_allowed", "live_eligibility_status"],
  "properties": {"schema_version": {"const": "1.0.0"}, "finding_id": {"type": "string", "minLength": 1}, "detected_at": {"$ref": "urn:ai4binance:schema:primitives:temporal-primitives:1.0.0#/$defs/timestamp_utc"}, "status": {"enum": ["OPEN", "VALIDATED", "REJECTED"]}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "execution_allowed": {"const": false}, "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}}
}
