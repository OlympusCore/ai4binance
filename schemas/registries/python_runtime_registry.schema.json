{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4binance:schema:registries:python-runtime-registry:1.0.0",
  "title": "AI4Binance Python Runtime Registry",
  "description": "The canonical Python runtime contract for repository, environment, editor, and CI validation. It grants no execution or live-trading authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "status",
    "authority",
    "source_of_truth",
    "source_of_truth_scope",
    "machine_enforceable",
    "audit_required",
    "classification",
    "canonical_path",
    "schema_ref",
    "execution_allowed",
    "promotion_status",
    "live_eligibility_status",
    "runtime"
  ],
  "properties": {
    "registry_id": {"const": "AI4B-PYTHON-RUNTIME-REGISTRY-001"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "ACTIVE"},
    "authority": {"const": "CANONICAL"},
    "source_of_truth": {"const": true},
    "source_of_truth_scope": {"const": "python_runtime"},
    "machine_enforceable": {"const": true},
    "audit_required": {"const": true},
    "classification": {"const": "INTERNAL"},
    "canonical_path": {"const": "docs/registries/registry_python_runtime.yaml"},
    "schema_ref": {"const": "schemas/registries/python_runtime_registry.schema.json"},
    "execution_allowed": {"const": false},
    "promotion_status": {"const": "RESEARCH_ONLY"},
    "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "implementation",
        "version",
        "major_minor",
        "architecture",
        "abi",
        "free_threaded",
        "gil_enabled",
        "jit_enabled",
        "project_environment",
        "executable",
        "include_system_site_packages",
        "global_site_packages",
        "system_site_packages",
        "project_packages"
      ],
      "properties": {
        "runtime_id": {"const": "python-runtime"},
        "implementation": {"const": "CPython"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "major_minor": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "architecture": {"const": "x86_64"},
        "abi": {"type": "string", "pattern": "^cp[0-9]+-win_amd64$"},
        "free_threaded": {"const": false},
        "gil_enabled": {"const": true},
        "jit_enabled": {"const": false},
        "project_environment": {"const": ".venv"},
        "executable": {"const": ".venv/Scripts/python.exe"},
        "include_system_site_packages": {"const": false},
        "global_site_packages": {"const": "FORBIDDEN"},
        "system_site_packages": {"const": "FORBIDDEN"},
        "project_packages": {"const": "VENV_ONLY"}
      }
    }
  }
}
