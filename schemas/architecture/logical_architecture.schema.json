{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4binance.local/schemas/architecture/logical_architecture.schema.json",
  "title": "AI4BINANCE Logical Architecture Registry",
  "description": "A machine-readable enforcement mirror of declared logical architecture. It is not an architecture source of truth and cannot authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "version", "status", "source_of_truth", "execution_allowed", "live_eligibility_status", "components", "relations", "core_modules"],
  "properties": {
    "registry_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"const": "ACTIVE"},
    "source_of_truth": {"const": false},
    "execution_allowed": {"const": false},
    "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"},
    "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "logical_component.schema.json"}},
    "relations": {"type": "array", "uniqueItems": true, "items": {"$ref": "logical_relation.schema.json"}},
    "core_modules": {
      "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["core_id", "term_id", "component_ids", "enforcement_entrypoints"],
        "properties": {
          "core_id": {"enum": ["DataCore", "TradeCore", "SystemCore", "SecurityCore", "AuditCore", "RiskCore", "TechnologyCore", "ServiceCore", "LearningCore", "ValidationCore", "DecisionCore", "DeterministicCore"]},
          "term_id": {"type": "string", "pattern": "^AI4B-TERM-[A-Z0-9-]+$"},
          "component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "enforcement_entrypoints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "accountability_refs": {
            "type": "object", "additionalProperties": false,
            "required": ["human_authority", "logical_owner", "technical_owner", "validation_owner"],
            "properties": {
              "human_authority": {"type": "string", "minLength": 1},
              "logical_owner": {"type": "string", "minLength": 1},
              "technical_owner": {"type": "string", "minLength": 1},
              "validation_owner": {"type": "string", "minLength": 1}
            }
          },
          "accountable_component_id": {"type": "string", "minLength": 1},
          "assurance": {"$ref": "#/$defs/CoreAssuranceContract"}
        }
      }
    }
  },
  "$defs": {
    "CoreAssuranceContract": {
      "type": "object", "additionalProperties": false,
      "required": ["required_dimensions", "interfaces", "failure_test_refs", "resource_budget_ref", "evidence_max_age_seconds", "veto_boundary_refs", "forbidden_authorities"],
      "properties": {
        "required_dimensions": {"const": ["ownership", "input_output", "dependencies", "veto_boundary", "failure_behavior", "resource_budget", "tests_evidence", "runtime_consumer"]},
        "interfaces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/CoreInterfaceBinding"}},
        "failure_test_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resource_budget_ref": {"type": ["string", "null"], "pattern": "^config/.+[.](yaml|toml)$"},
        "evidence_max_age_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "veto_boundary_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_authorities": {"const": ["live_execution_authority", "risk_override", "validation_override", "governance_bypass"]}
      }
    },
    "CoreInterfaceBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["interface_id", "component_id", "contract_ref", "producer_ref", "consumer_ref"],
      "properties": {
        "interface_id": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "contract_ref": {"type": "string", "minLength": 1},
        "producer_ref": {"type": "string", "pattern": "^.+[.]py::[A-Za-z_][A-Za-z_0-9.]*$"},
        "consumer_ref": {"type": "string", "pattern": "^.+[.]py::[A-Za-z_][A-Za-z_0-9.]*$"}
      }
    }
  }
}
