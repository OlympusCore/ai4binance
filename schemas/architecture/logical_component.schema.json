{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4binance.local/schemas/architecture/logical_component.schema.json",
  "title": "AI4BINANCE Logical Architecture Component",
  "description": "A non-authoritative logical-component declaration. It cannot grant decision, risk-override, validation-override, promotion, or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_id",
    "component_kind",
    "canonical_domain",
    "logical_plane",
    "dependency_layer",
    "runtime_class",
    "owner",
    "authority_effect",
    "source_paths",
    "contract_refs",
    "test_refs",
    "hot_path",
    "deterministic",
    "llm_dependency",
    "side_effects",
    "decision_authority",
    "risk_override",
    "validation_override",
    "source_of_truth",
    "execution_allowed",
    "live_eligibility_status"
  ],
  "properties": {
    "component_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "component_kind": {"enum": ["ADAPTER", "ADVISORY_AGENT", "CAPABILITY", "CONTROL", "DOMAIN", "ENGINE", "FACADE", "GATE", "ORCHESTRATOR", "REGISTRY", "RUNTIME_ACTOR", "SERVICE"]},
    "canonical_domain": {"enum": ["00_META", "01_REGISTRIES", "02_MARKET_DATA", "03_SHARED_MARKET_STATE", "04_INTELLIGENCE", "05_DETERMINISTIC_ANALYTICS", "06_AGENT_OBSERVATIONS", "07_DECISION", "08_RISK", "09_PORTFOLIO", "10_EXECUTION", "11_VALIDATION", "12_LEARNING", "13_GOVERNANCE", "14_EVIDENCE", "15_AUDIT_OBSERVABILITY", "16_SECURITY", "17_EVENT_FABRIC", "18_RESEARCH_CAPABILITY"]},
    "logical_plane": {"enum": ["CONTROL & ASSURANCE PLANE", "DATA & EVIDENCE PLANE", "INTELLIGENCE PLANE", "DECISION & EXECUTION PLANE", "ORCHESTRATION + EVENT FABRIC"]},
    "dependency_layer": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "runtime_class": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "owner": {"type": "string", "minLength": 1},
    "authority_effect": {"enum": ["EVIDENCE_ONLY", "IMPLEMENTATION", "VETO"]},
    "source_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repository_path"}},
    "contract_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repository_path"}},
    "test_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repository_path"}},
    "hot_path": {"type": "boolean"},
    "deterministic": {"type": "boolean"},
    "llm_dependency": {"type": "boolean"},
    "side_effects": {"const": false},
    "decision_authority": {"const": false},
    "risk_override": {"const": false},
    "validation_override": {"const": false},
    "source_of_truth": {"const": false},
    "execution_allowed": {"const": false},
    "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}
  },
  "$defs": {
    "repository_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
  }
}
