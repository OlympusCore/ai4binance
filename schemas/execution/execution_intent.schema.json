{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4binance:schema:execution:execution-intent:1.0.0",
  "title": "AI4Binance Execution Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_id", "decision_id", "execution_allowed", "live_eligibility_status", "reason_codes"],
  "properties": {"schema_version": {"const": "1.0.0"}, "intent_id": {"type": "string", "minLength": 1}, "decision_id": {"type": "string", "minLength": 1}, "execution_allowed": {"const": false}, "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
