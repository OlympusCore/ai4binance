{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4binance.local/schemas/governance/authority_node.schema.json",
  "title": "AI4BINANCE AuthorityNode",
  "description": "A read-only authority declaration. It records governed metadata and cannot grant execution or promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "document_id",
    "canonical_path",
    "authority_layer",
    "authority_effect",
    "authority_scope",
    "lifecycle_status",
    "content_role",
    "source_of_truth",
    "source_of_truth_scope"
  ],
  "properties": {
    "node_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "pattern": "^AI4B(?:-[A-Z0-9]+){2,}-[0-9]{3}$"},
    "canonical_path": {"type": "string", "pattern": "^[^\\\\/].*[^\\\\]$"},
    "authority_layer": {"$ref": "#/$defs/authority_layer"},
    "authority_effect": {"$ref": "#/$defs/authority_effect"},
    "authority_scope": {"$ref": "#/$defs/lower_snake_case"},
    "lifecycle_status": {"$ref": "#/$defs/lifecycle_status"},
    "content_role": {"$ref": "#/$defs/content_role"},
    "source_of_truth": {"type": "boolean"},
    "source_of_truth_scope": {"$ref": "#/$defs/lower_snake_case"}
  },
  "allOf": [
    {
      "if": {"properties": {"content_role": {"const": "GENERATED"}}},
      "then": {"properties": {"source_of_truth": {"const": false}}}
    },
    {
      "if": {"properties": {"source_of_truth": {"const": true}}},
      "then": {
        "properties": {
          "content_role": {"enum": ["AUTHORITATIVE", "OPERATIONAL", "POLICY_AS_CODE"]}
        }
      }
    }
  ],
  "$defs": {
    "authority_layer": {
      "enum": [
        "L0_EXTERNAL_MANDATORY_CONSTRAINTS",
        "L1_CORE_CONSTITUTION",
        "L2_GOVERNANCE_COMPLIANCE",
        "L3_CANONICAL_CONTRACTS_SCHEMAS",
        "L4_REPOSITORY_STANDARDS_CONTROLS_QUALITY_POLICIES",
        "L5_REGISTRIES_ROADMAP",
        "L6_ARCHITECTURE_ONTOLOGY_ADR",
        "L7_WORKFLOWS_PROCEDURES_RUNBOOKS_PROVIDERS",
        "L8_REPORTS_EVIDENCE_INVENTORIES",
        "L9_REFERENCES_TEMPLATES",
        "L10_ARCHIVE_STRUCTURAL_PLACEHOLDERS"
      ]
    },
    "authority_effect": {
      "enum": [
        "MANDATORY_CONSTRAINT",
        "NORMATIVE_CONSTRAINT",
        "OPERATIONAL_SPECIALIZATION",
        "IMPLEMENTATION",
        "EVIDENCE_ONLY",
        "REFERENCE_ONLY",
        "ARCHIVE_ONLY"
      ]
    },
    "content_role": {
      "enum": [
        "AUTHORITATIVE",
        "POLICY_AS_CODE",
        "EXPLANATORY",
        "GENERATED",
        "DERIVED",
        "HISTORICAL",
        "OPERATIONAL",
        "EVIDENCE"
      ]
    },
    "lifecycle_status": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "ACTIVE",
        "SUPERSEDED",
        "DEPRECATED",
        "ARCHIVED",
        "SUSPENDED",
        "QUARANTINED",
        "REJECTED"
      ]
    },
    "lower_snake_case": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
  }
}
