{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4binance.local/schemas/governance/technology_language_ownership.schema.json",
  "title": "AI4BINANCE Technology Language Ownership Policy Projection",
  "description": "Machine-readable enforcement projection of the canonical technology language ownership standard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "policy_id",
    "version",
    "status",
    "authority_layer",
    "authority_effect",
    "authority_scope",
    "content_role",
    "source_of_truth",
    "source_of_truth_scope",
    "canonical_path",
    "authority",
    "safety",
    "interoperability",
    "languages"
  ],
  "properties": {
    "document_id": {"const": "AI4B-GOV-TECH-LANG-001"},
    "policy_id": {"const": "AI4B-GOV-TECH-LANG-001"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"const": "ACTIVE"},
    "authority_layer": {
      "const": "L4_REPOSITORY_STANDARDS_CONTROLS_QUALITY_POLICIES"
    },
    "authority_effect": {"const": "IMPLEMENTATION"},
    "authority_scope": {"const": "technology_language_ownership"},
    "content_role": {"const": "POLICY_AS_CODE"},
    "source_of_truth": {"const": false},
    "source_of_truth_scope": {"const": "enforcement_projection"},
    "canonical_path": {
      "const": "config/governance/technology_language_ownership.yaml"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_id",
        "human_authority_ref",
        "authority_scope",
        "projection_role",
        "source_of_truth",
        "not_authoritative_for"
      ],
      "properties": {
        "standard_id": {"const": "AI4B-ARCH-STD-LANG-001"},
        "human_authority_ref": {"const": "docs/standards/standard_technology_language_ownership.md"},
        "authority_scope": {"const": "technology_language_ownership"},
        "projection_role": {"const": "ENFORCEMENT_PROJECTION"},
        "source_of_truth": {"const": false},
        "not_authoritative_for": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "enterprise_constitution",
              "domain_semantics",
              "risk_policy",
              "trading_policy",
              "canonical_schema_field_semantics",
              "compliance_requirements",
              "execution_authority"
            ]
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_allowed", "promotion_status", "live_eligibility_status"],
      "properties": {
        "execution_allowed": {"const": false},
        "promotion_status": {"const": "RESEARCH_ONLY"},
        "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}
      }
    },
    "interoperability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_roots",
        "research_only_roots",
        "forbidden_production_references"
      ],
      "properties": {
        "production_roots": {"$ref": "#/$defs/pathList"},
        "research_only_roots": {"$ref": "#/$defs/pathList"},
        "forbidden_production_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "rust",
        "cuda_cpp",
        "sql",
        "typescript",
        "css",
        "go",
        "julia",
        "java",
        "powershell",
        "bash",
        "yaml_toml",
        "json_schema"
      ],
      "properties": {
        "python": {"$ref": "#/$defs/languageRule"},
        "rust": {"$ref": "#/$defs/languageRule"},
        "cuda_cpp": {"$ref": "#/$defs/languageRule"},
        "sql": {"$ref": "#/$defs/languageRule"},
        "typescript": {"$ref": "#/$defs/languageRule"},
        "css": {"$ref": "#/$defs/languageRule"},
        "go": {"$ref": "#/$defs/languageRule"},
        "julia": {"$ref": "#/$defs/languageRule"},
        "java": {"$ref": "#/$defs/languageRule"},
        "powershell": {"$ref": "#/$defs/languageRule"},
        "bash": {"$ref": "#/$defs/languageRule"},
        "yaml_toml": {"$ref": "#/$defs/languageRule"},
        "json_schema": {"$ref": "#/$defs/languageRule"}
      }
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^[^\\\\].*$"}
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "adoptionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_required_if_present", "evidence_refs"],
      "properties": {
        "evidence_required_if_present": {"type": "boolean"},
        "evidence_refs": {"$ref": "#/$defs/stringList"}
      }
    },
    "languageRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "suffixes",
        "enforce_placement",
        "allowed_paths",
        "allowed_capabilities",
        "forbidden_capabilities",
        "forbidden_content_patterns",
        "adoption_gate"
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "suffixes": {"$ref": "#/$defs/stringList"},
        "enforce_placement": {"type": "boolean"},
        "allowed_paths": {"$ref": "#/$defs/pathList"},
        "allowed_capabilities": {"$ref": "#/$defs/stringList"},
        "forbidden_capabilities": {"$ref": "#/$defs/stringList"},
        "forbidden_content_patterns": {"$ref": "#/$defs/stringList"},
        "adoption_gate": {"$ref": "#/$defs/adoptionGate"}
      }
    }
  }
}

