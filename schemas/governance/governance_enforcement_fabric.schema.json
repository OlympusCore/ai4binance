{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4binance.local/schemas/governance/governance_enforcement_fabric.schema.json",
  "title": "AI4BINANCE Governance Enforcement Fabric",
  "description": "Single non-authoritative wiring contract for terminology, repository naming, and technology-language ownership enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "fabric_id", "version", "status", "authority_layer", "authority_effect", "authority_scope", "content_role", "source_of_truth", "source_of_truth_scope", "canonical_path", "safety", "families", "quality_gate"],
  "properties": {
    "document_id": {"const": "AI4B-GOV-FABRIC-001"}, "fabric_id": {"const": "AI4B-GOV-FABRIC-001"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}, "status": {"const": "ACTIVE"},
    "authority_layer": {"const": "L4_REPOSITORY_STANDARDS_CONTROLS_QUALITY_POLICIES"}, "authority_effect": {"const": "IMPLEMENTATION"},
    "authority_scope": {"const": "governance_enforcement_fabric"},
    "content_role": {"const": "POLICY_AS_CODE"}, "source_of_truth": {"const": false},
    "source_of_truth_scope": {"const": "enforcement_projection"}, "canonical_path": {"const": "config/governance/governance_enforcement_fabric.yaml"},
    "safety": {"type": "object", "additionalProperties": false, "required": ["execution_allowed", "promotion_status", "live_eligibility_status"], "properties": {"execution_allowed": {"const": false}, "promotion_status": {"const": "RESEARCH_ONLY"}, "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}}},
    "families": {"type": "object", "additionalProperties": false, "required": ["terminology", "repository_naming", "technology_language"], "properties": {"terminology": {"$ref": "#/$defs/family"}, "repository_naming": {"$ref": "#/$defs/family"}, "technology_language": {"$ref": "#/$defs/family"}}},
    "quality_gate": {"$ref": "#/$defs/quality_gate"}
  },
  "$defs": {
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_scope", "standard_path", "standard_id", "standard_version", "standard_content_sha256", "projection_path", "schema_path"],
      "properties": {
        "authority_scope": {"type": "string", "minLength": 1}, "standard_path": {"type": "string", "minLength": 1},
        "standard_id": {"type": "string", "minLength": 1}, "standard_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "standard_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "projection_path": {"type": "string", "minLength": 1},
        "schema_path": {"type": ["string", "null"]}
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_pyramid_ref", "authority_graph_path", "authority_development_matrix_path", "quality_policy_path", "minimum_profile", "authority_separation", "pillars", "evaluation_axes"],
      "properties": {
        "authority_pyramid_ref": {"const": "docs/governance/framework_core_vnext_governance.md"},
        "authority_graph_path": {"const": "docs/registries/registry_authority_graph.yaml"},
        "authority_development_matrix_path": {"const": "config/governance/authority_layer_development_matrix.yaml"},
        "quality_policy_path": {"const": "config/quality/gates.yaml"},
        "minimum_profile": {"const": "standard"},
        "authority_separation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministic_quality_gate", "deterministic_governance_gate", "human_governance"],
          "properties": {
            "deterministic_quality_gate": {"const": "TECHNICAL_TRUTH"},
            "deterministic_governance_gate": {"const": "POLICY_ELIGIBILITY"},
            "human_governance": {"const": "CONSEQUENTIAL_AUTHORITY"}
          }
        },
        "pillars": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kaizen", "lean", "six_sigma"],
          "properties": {
            "kaizen": {"$ref": "#/$defs/quality_pillar"},
            "lean": {"$ref": "#/$defs/quality_pillar"},
            "six_sigma": {"$ref": "#/$defs/quality_pillar"}
          }
        },
        "evaluation_axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "capability", "component", "guardrail", "eval", "assurance"],
          "properties": {
            "layer": {"$ref": "#/$defs/quality_axis"},
            "capability": {"$ref": "#/$defs/quality_axis"},
            "component": {"$ref": "#/$defs/quality_axis"},
            "guardrail": {"$ref": "#/$defs/quality_axis"},
            "eval": {"$ref": "#/$defs/quality_axis"},
            "assurance": {"$ref": "#/$defs/quality_axis"}
          }
        }
      }
    },
    "quality_pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_role", "standard_mapping_names", "required_paths", "required_tests"],
      "properties": {
        "semantic_role": {"enum": ["CULTURE", "PROCESS", "PERFORMANCE"]},
        "standard_mapping_names": {"$ref": "#/$defs/non_empty_unique_strings"},
        "required_paths": {"$ref": "#/$defs/non_empty_unique_strings"},
        "required_tests": {"$ref": "#/$defs/non_empty_unique_strings"}
      }
    },
    "quality_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "standard_mapping_names", "required_paths", "required_tests"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "standard_mapping_names": {"$ref": "#/$defs/non_empty_unique_strings"},
        "required_paths": {"$ref": "#/$defs/non_empty_unique_strings"},
        "required_tests": {"$ref": "#/$defs/non_empty_unique_strings"}
      }
    },
    "non_empty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
