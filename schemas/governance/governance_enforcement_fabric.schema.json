{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4binance.local/schemas/governance/governance_enforcement_fabric.schema.json",
  "title": "AI4BINANCE Governance Enforcement Fabric",
  "description": "Single non-authoritative wiring contract for terminology, repository naming, and technology-language ownership enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "fabric_id", "version", "status", "authority_layer", "authority_effect", "authority_scope", "content_role", "source_of_truth", "source_of_truth_scope", "canonical_path", "safety", "families", "quality_gate"],
  "properties": {
    "document_id": {"const": "AI4B-GOV-FABRIC-001"}, "fabric_id": {"const": "AI4B-GOV-FABRIC-001"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}, "status": {"const": "ACTIVE"},
    "authority_layer": {"const": "L4_REPOSITORY_STANDARDS_CONTROLS_QUALITY_POLICIES"}, "authority_effect": {"const": "IMPLEMENTATION"},
    "authority_scope": {"const": "governance_enforcement_fabric"},
    "content_role": {"const": "POLICY_AS_CODE"}, "source_of_truth": {"const": false},
    "source_of_truth_scope": {"const": "enforcement_projection"}, "canonical_path": {"const": "config/governance/governance_enforcement_fabric.yaml"},
    "safety": {"type": "object", "additionalProperties": false, "required": ["execution_allowed", "promotion_status", "live_eligibility_status"], "properties": {"execution_allowed": {"const": false}, "promotion_status": {"const": "RESEARCH_ONLY"}, "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}}},
    "families": {"type": "object", "additionalProperties": false, "required": ["terminology", "repository_naming", "technology_language"], "properties": {"terminology": {"$ref": "#/$defs/family"}, "repository_naming": {"$ref": "#/$defs/family"}, "technology_language": {"$ref": "#/$defs/family"}}},
    "quality_gate": {"$ref": "#/$defs/quality_gate"},
    "repository_git": {"$ref": "#/$defs/repository_git"},
    "bounded_owner_acceptance": {"$ref": "#/$defs/bounded_owner_acceptance"}
  },
  "$defs": {
    "bounded_owner_acceptance": {"type": "object", "additionalProperties": false, "required": ["rule_id", "core_ref", "core_section", "core_sha256", "canonical_root", "epoch_id", "package_base_commit", "package_commit", "package_patch_sha256", "owner_person_id", "approver_id", "principal_id", "approver_role", "normative_decision_ref", "allowed_change_paths", "reviewed_output_paths", "source_of_truth", "projection_role", "review_baseline_commit"], "properties": {"rule_id": {"const": "AI4B-GOV-C3-OWNER-20261007"}, "core_ref": {"const": "docs/governance/framework_core_vnext_governance.md"}, "core_section": {"const": "3.1.2"}, "core_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "canonical_root": {"type": "string", "pattern": "^(?:[A-Za-z]:/|/).+"}, "epoch_id": {"const": "AI4B_CANONICAL_GIT_RULE_OWNER_REPAIR_20261007"}, "package_base_commit": {"const": "51aa502297903c52f98d58e63f6c916b43bce433"}, "package_commit": {"const": "f3d81cb6bb57f9fe6e69661f1ddbbcf4db4d5901"}, "package_patch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "owner_person_id": {"const": "Huseyin Cicek"}, "approver_id": {"const": "Huseyin"}, "principal_id": {"const": "huseyin-governance-owner-principal"}, "approver_role": {"const": "GovernanceOwner"}, "normative_decision_ref": {"const": "runtime/artifacts/git_consolidation/canonical-baseline-rule-20261007/bounded-owner-amendment/quality-repair-normative-owner-decision.json"}, "allowed_change_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reviewed_output_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "source_of_truth": {"const": false}, "projection_role": {"const": "ENFORCEMENT_PROJECTION"}, "review_baseline_commit": {"const": "72cf9ca3a926508b499601f55d8fda857c452186"}}},
    "bounded_owner_normative_decision": {"type": "object", "additionalProperties": false, "required": ["contract_version", "rule_id", "record_origin", "status", "decision", "owner_person_id", "grant", "source", "subject_sha256", "issued_at_utc", "expires_at_utc", "revoked_at_utc", "human_confirmation", "natural_person_count", "independent_human_review", "departure_from_legacy_c3", "previous_c3_approval", "historical_approval_gaps_closed", "execution_allowed", "promotion_status", "live_eligibility_status"], "properties": {"contract_version": {"const": "BoundedOwnerNormativeAmendment/v1"}, "rule_id": {"const": "AI4B-GOV-C3-OWNER-20261007"}, "record_origin": {"const": "OWNER_ISSUED"}, "status": {"const": "ISSUED"}, "decision": {"const": "RECOGNIZE_EXACT_OWNER_PACKAGE_ACCEPTANCE"}, "owner_person_id": {"const": "Huseyin Cicek"}, "grant": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^runtime/artifacts/[A-Za-z0-9_./-]+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^runtime/artifacts/[A-Za-z0-9_./-]+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "issued_at_utc": {"type": "string", "format": "date-time"}, "expires_at_utc": {"type": "string", "format": "date-time"}, "revoked_at_utc": {"type": ["string", "null"], "format": "date-time"}, "human_confirmation": {"const": true}, "natural_person_count": {"const": 1}, "independent_human_review": {"const": false}, "departure_from_legacy_c3": {"const": true}, "previous_c3_approval": {"const": false}, "historical_approval_gaps_closed": {"const": false}, "execution_allowed": {"const": false}, "promotion_status": {"const": "RESEARCH_ONLY"}, "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}}},
    "repository_git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "core_ref", "core_section", "core_sha256", "policy_ref", "policy_sha256", "canonical_root", "canonical_remote_url", "projection_role", "source_of_truth"],
      "properties": {
        "rule_id": {"const": "AI4B-GOV-GIT-001"},
        "core_ref": {"const": "docs/governance/framework_core_vnext_governance.md"},
        "core_section": {"const": "3.2"},
        "core_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_ref": {"const": "docs/governance/policy_manifest_governance.md"},
        "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "canonical_root": {"type": "string", "pattern": "^(?:[A-Za-z]:/|/).+"},
        "canonical_remote_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"},
        "projection_role": {"const": "ENFORCEMENT_PROJECTION"},
        "source_of_truth": {"const": false}
      }
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_scope", "standard_path", "standard_id", "standard_version", "standard_content_sha256", "projection_path", "schema_path"],
      "properties": {
        "authority_scope": {"type": "string", "minLength": 1}, "standard_path": {"type": "string", "minLength": 1},
        "standard_id": {"type": "string", "minLength": 1}, "standard_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "standard_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "projection_path": {"type": "string", "minLength": 1},
        "schema_path": {"type": ["string", "null"]}
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_pyramid_ref", "authority_graph_path", "authority_development_matrix_path", "quality_policy_path", "minimum_profile", "authority_separation", "pillars", "evaluation_axes"],
      "properties": {
        "authority_pyramid_ref": {"const": "docs/governance/framework_core_vnext_governance.md"},
        "authority_graph_path": {"const": "docs/registries/registry_authority_graph.yaml"},
        "authority_development_matrix_path": {"const": "config/governance/authority_layer_development_matrix.yaml"},
        "quality_policy_path": {"const": "config/quality/gates.yaml"},
        "minimum_profile": {"const": "standard"},
        "authority_separation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministic_quality_gate", "deterministic_governance_gate", "human_governance"],
          "properties": {
            "deterministic_quality_gate": {"const": "TECHNICAL_TRUTH"},
            "deterministic_governance_gate": {"const": "POLICY_ELIGIBILITY"},
            "human_governance": {"const": "CONSEQUENTIAL_AUTHORITY"}
          }
        },
        "pillars": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kaizen", "lean", "six_sigma"],
          "properties": {
            "kaizen": {"$ref": "#/$defs/quality_pillar"},
            "lean": {"$ref": "#/$defs/quality_pillar"},
            "six_sigma": {"$ref": "#/$defs/quality_pillar"}
          }
        },
        "evaluation_axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layer", "capability", "component", "guardrail", "eval", "assurance"],
          "properties": {
            "layer": {"$ref": "#/$defs/quality_axis"},
            "capability": {"$ref": "#/$defs/quality_axis"},
            "component": {"$ref": "#/$defs/quality_axis"},
            "guardrail": {"$ref": "#/$defs/quality_axis"},
            "eval": {"$ref": "#/$defs/quality_axis"},
            "assurance": {"$ref": "#/$defs/quality_axis"}
          }
        }
      }
    },
    "quality_pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_role", "standard_mapping_names", "required_paths", "required_tests"],
      "properties": {
        "semantic_role": {"enum": ["CULTURE", "PROCESS", "PERFORMANCE"]},
        "standard_mapping_names": {"$ref": "#/$defs/non_empty_unique_strings"},
        "required_paths": {"$ref": "#/$defs/non_empty_unique_strings"},
        "required_tests": {"$ref": "#/$defs/non_empty_unique_strings"}
      }
    },
    "quality_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "standard_mapping_names", "required_paths", "required_tests"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "standard_mapping_names": {"$ref": "#/$defs/non_empty_unique_strings"},
        "required_paths": {"$ref": "#/$defs/non_empty_unique_strings"},
        "required_tests": {"$ref": "#/$defs/non_empty_unique_strings"}
      }
    },
    "non_empty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
