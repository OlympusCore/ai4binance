{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4binance.local/schemas/governance/authority_graph.schema.json",
  "title": "AI4BINANCE AuthorityGraph",
  "description": "A non-authoritative registry projection of declared authority metadata and relationships. It cannot grant execution or promotion authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "version",
    "status",
    "source_of_truth",
    "execution_allowed",
    "live_eligibility_status",
    "nodes",
    "edges"
  ],
  "properties": {
    "graph_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"const": "ACTIVE"},
    "source_of_truth": {"const": false},
    "execution_allowed": {"const": false},
    "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "authority_node.schema.json"}
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "authority_edge.schema.json"}
    }
  }
}
