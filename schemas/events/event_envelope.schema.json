{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai4binance:schema:events:event-envelope:1.0.0",
  "title": "AI4Binance Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "correlation_id", "causation_id", "cycle_id", "snapshot_id", "producer", "created_at", "payload_hash", "payload", "execution_allowed", "live_eligibility_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["SNAPSHOT_CREATED", "EVIDENCE_BUNDLE_READY", "RISK_ASSESSMENT_COMPLETED", "VALIDATION_COMPLETED", "DECISION_CREATED", "CLOSURE_REVIEW_COMPLETED"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": ["string", "null"]},
    "cycle_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"$ref": "urn:ai4binance:schema:primitives:identifier-primitives:1.0.0#/$defs/snapshot_id"},
    "producer": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "urn:ai4binance:schema:primitives:temporal-primitives:1.0.0#/$defs/timestamp_utc"},
    "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload": {"type": "object"},
    "execution_allowed": {"const": false},
    "live_eligibility_status": {"const": "LIVE_ORDER_BLOCKED"}
  }
}
