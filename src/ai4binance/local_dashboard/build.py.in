"""Package the approved dashboard design for offline local operation."""

from pathlib import Path
import re
import subprocess
import sys

app = Path(__file__).resolve().parent
fragment = Path(sys.argv[1]).read_text(encoding="utf-8")
css = re.search(r"<style>([\s\S]*?)</style>", fragment).group(1)
interface_root = Path(sys.argv[2]) if len(sys.argv) > 2 else app
repository_root = Path(sys.argv[3]) if len(sys.argv) > 3 else interface_root.parents[1]
# Type-check the canonical sources with the pinned, already installed toolchain.
subprocess.run(
    [sys.executable, "-B", str(repository_root / "scripts/check_dashboard_types.py")],
    cwd=repository_root, capture_output=True, text=True, check=True, timeout=60,
)


def compile_interface(name):
    source = (interface_root / name).read_text(encoding="utf-8")
    return subprocess.run(
        [
            "node",
            "--input-type=module",
            "-e",
            "import {stripTypeScriptTypes} from 'node:module';"
            "let source='';for await(const part of process.stdin)source+=part;"
            "process.stdout.write(stripTypeScriptTypes(source));",
        ],
        input=source,
        text=True,
        encoding="utf-8",
        capture_output=True,
        check=True,
        timeout=30,
    ).stdout


js = (
    compile_interface("dashboard_icons.ts")
    + "\n"
    + compile_interface("dashboard_shell.ts")
)
compiled = compile_interface("command_center.ts")
css += "\n" + (interface_root / "command_center.css").read_text(encoding="utf-8")
markup = re.sub(
    r"<style>[\s\S]*?</style>|<script>[\s\S]*?</script>", "", fragment
).strip()
marker = "// @dashboard-adapters"
assert js.count(marker) == 1, "DASHBOARD_COMPOSITION_MARKER_INVALID"
js = js.replace(
    marker, (app / "local_views.js").read_text(encoding="utf-8") + "\n" + compiled
)
document = (
    '<!doctype html>\n<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AI4Binance Dashboard</title><link rel="stylesheet" href="/app.css"><script src="/app.js" defer></script></head><body>\n'
    + markup
    + "\n</body></html>\n"
)
(app / "index.html").write_text(document, encoding="utf-8")
(app / "app.js").write_text(js, encoding="utf-8")
(app / "app.css").write_text(
    css,
    encoding="utf-8",
)
print("DASHBOARD_PACKAGE_BUILT")
